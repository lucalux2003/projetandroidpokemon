<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Pop_up_achivement">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="10dp"
        android:background="@drawable/assets_roundborder_edittext"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/textView2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@mipmap/ic_login_achivement"
            android:gravity="center_vertical"
            android:text="Achivement"
            android:textColor="@color/primary_button"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/divider11"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginBottom="20sp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:id="@+id/achivementText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20sp"
            android:text="TextView"
            android:textStyle="bold" />

    </LinearLayout>
</FrameLayout>